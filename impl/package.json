{
	"name": "menma-cli",
	"version": "1.0.0",
	"description": "CLI-based file management tool",
	"license": "MIT",
	"bin": "dist/cli.js",
	"type": "module",
	"engines": {
		"node": ">=16"
	},
	"scripts": {
		"build": "esbuild source/**/*.js --outdir=dist --platform=node --target=es2020 --format=esm --jsx=automatic --jsx-import-source=react --loader:.js=jsx",
		"dev": "esbuild source/**/*.js --outdir=dist --platform=node --target=es2020 --format=esm --jsx=automatic --jsx-import-source=react --loader:.js=jsx --watch",
		"test": "prettier --check . && xo && ava"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"ink": "^4.1.0",
		"ink-select-input": "^5.0.0",
		"ink-text-input": "^5.0.1",
		"meow": "^11.0.0",
		"react": "^18.2.0",
		"string-width": "^7.2.0"
	},
	"devDependencies": {
		"@vdemedes/prettier-config": "^2.0.1",
		"ava": "^5.2.0",
		"chalk": "^5.2.0",
		"esbuild": "^0.25.5",
		"eslint-config-xo-react": "^0.27.0",
		"eslint-plugin-react": "^7.32.2",
		"eslint-plugin-react-hooks": "^4.6.0",
		"ink-testing-library": "^3.0.0",
		"prettier": "^2.8.7",
		"xo": "^0.53.1"
	},
	"ava": {
		"environmentVariables": {
			"NODE_NO_WARNINGS": "1"
		}
	},
	"xo": {
		"extends": "xo-react",
		"prettier": true,
		"rules": {
			"react/prop-types": "off"
		}
	},
	"prettier": "@vdemedes/prettier-config"
}
